{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spotgrid gold export manifest",
  "description": "_manifest.json in the serving bucket, written after every table of an export.",
  "type": "object",
  "required": ["version", "exported_at", "attribution", "tables"],
  "properties": {
    "version": { "const": 2 },
    "exported_at": { "type": "string", "format": "date-time" },
    "attribution": { "type": "string", "minLength": 1 },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["key", "rows", "time_column", "max_time", "sha256", "bytes", "columns"],
        "properties": {
          "key": { "type": "string", "pattern": "^gold/[a-z_]+\\.parquet$" },
          "rows": { "type": "integer", "minimum": 0 },
          "time_column": { "type": "string" },
          "max_time": { "type": ["string", "null"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": { "name": { "type": "string" }, "type": { "type": "string" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
