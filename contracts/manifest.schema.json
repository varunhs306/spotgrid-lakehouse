{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spotgrid gold export manifest",
  "description": "_manifest.json in the serving bucket, written after every partition of an export.",
  "type": "object",
  "required": ["version", "exported_at", "updated_through", "attribution", "tables"],
  "properties": {
    "version": { "const": 3 },
    "exported_at": { "type": "string", "format": "date-time" },
    "updated_through": { "type": "string", "format": "date-time" },
    "attribution": { "type": "string", "minLength": 1 },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["time_column", "area_column", "columns", "partitions", "bulk", "rows", "max_time"],
        "properties": {
          "time_column": { "type": "string" },
          "area_column": { "type": ["string", "null"] },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": { "name": { "type": "string" }, "type": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "partitions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } },
          "bulk": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } },
          "rows": { "type": "integer", "minimum": 0 },
          "max_time": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": ["key", "rows", "max_time", "sha256", "bytes"],
      "properties": {
        "key": { "type": "string", "pattern": "^(gold|bulk)/[A-Za-z0-9_./-]+\\.(parquet|csv)$" },
        "rows": { "type": "integer", "minimum": 0 },
        "max_time": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
